# ============================================
# Variables de Entorno - Manteni+ Escolar
# ============================================

# Entorno
NODE_ENV=production

# JWT Secret (CAMBIAR en producción - usar una clave segura)
JWT_SECRET=tu-clave-secreta-muy-larga-y-segura-aqui-cambiar-en-produccion

# Puerto de la aplicación
PORT=3000


# Base de datos PostgreSQL (cuando migres de DB en memoria)
# DATABASE_URL=postgresql://manteni_user:password@postgres:5432/manteni_db
# DB_PASSWORD=changeme123

# Configuración de cookies
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Logging
LOG_LEVEL=info

# ============================================
# Notas:
# ============================================
# 1. Copia este archivo a .env.local para desarrollo
# 2. Copia a .env.production para producción
# 3. NUNCA subas archivos .env a Git
# 4. Cambia JWT_SECRET por una clave única y segura
# 5. Puedes generar una clave segura con:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
